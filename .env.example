CLERK_JWKS_URL=https://your-clerk-frontend-api/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_ENABLE_STREAMING=false
LAZY_HYDRATION_ENABLED=true
HYDRATED_DOCUMENT_CACHE_SIZE=8
MAX_CONCURRENT_HYDRATIONS=3
AI_DISCOVERY_MAX_DOCUMENTS=6
